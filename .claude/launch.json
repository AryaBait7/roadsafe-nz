{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "roadsafe-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "roadsafe-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "start",
        "--",
        "--port",
        "3200"
      ],
      "port": 3200
    },
    {
      "name": "roadsafe-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "run",
        "dev"
      ],
      "port": 4000
    }
  ]
}